---
import { img } from '../../lib/assets';
import { site } from '../../data/site';
---
<section class="loc on-ink section" id="kontak" aria-labelledby="loc-title">
  <div class="wrap loc__in">
    <div class="loc__text">
      <h2 id="loc-title" class="reveal">Lokasi & kontak</h2>
      <p class="loc__addr lead reveal" style="--i:1">{site.address}</p>

      <dl class="loc__lines reveal" style="--i:2">
        <div>
          <dt>Emergency</dt>
          <dd><a href={`tel:${site.emergencyShort}`}>{site.emergencyShort}</a> atau <a href="tel:+62215551888">{site.emergency}</a></dd>
        </div>
        <div>
          <dt>Informasi</dt>
          <dd><a href="tel:+62215551999">{site.info}</a></dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd><a href={site.whatsappUrl} target="_blank" rel="noopener">{site.whatsapp}</a></dd>
        </div>
      </dl>

      <dl class="loc__lines reveal" style="--i:3">
        {
          site.hours.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="reveal" style="--i:4">
        Parkir untuk 500 mobil dan 200 motor, gratis 2 jam pertama. Tersedia akses TransJakarta dan ojek online di depan rumah sakit.
      </p>
      <a class="btn btn--light reveal" style="--i:5" href="https://maps.google.com/?q=Jakarta+Timur" target="_blank" rel="noopener">Buka di Google Maps</a>
    </div>

    <div class="loc__media">
      <div class="loc__photo arch reveal">
        <img src={img('gedung')} alt="Gedung rumah sakit dengan jendela menyala saat senja" width="900" height="1350" loading="lazy" />
      </div>
      <div class="loc__map arch reveal" style={`--i:1;background-image:url(${img('jakarta')})`}>
        <iframe
          title="Peta lokasi RSU Bunda Sehat di Jakarta Timur"
          src="https://www.openstreetmap.org/export/embed.html?bbox=106.86%2C-6.26%2C106.96%2C-6.17&layer=mapnik"
          loading="lazy"
          referrerpolicy="no-referrer"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .loc {
    background: var(--ink);
    color: var(--bg);
  }
  .loc__in {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .loc__text {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .loc__addr {
    font-size: var(--step-lead);
  }
  .loc__lines {
    display: grid;
    gap: 10px;
    margin: 0;
    width: 100%;
  }
  .loc__lines > div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 16px;
  }
  .loc__lines dt {
    font-weight: 600;
  }
  .loc__lines dd {
    margin: 0;
  }
  .loc__text a:not(.btn) {
    text-underline-offset: 0.25em;
    text-decoration-thickness: 2px;
  }
  .loc__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 2vw, 24px);
    align-items: end;
  }
  .loc__photo,
  .loc__map {
    aspect-ratio: 3 / 5;
    background: var(--surface);
  }
  .loc__photo {
    margin-bottom: clamp(40px, 6vw, 96px);
  }
  .loc__photo img {
    object-position: 50% 50%;
  }
  .loc__map {
    background-size: cover;
    background-position: 30% 50%;
  }
  .loc__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.25) sepia(0.2);
  }
  @media (max-width: 960px) {
    .loc__in {
      grid-template-columns: 1fr;
    }
    .loc__lines > div {
      grid-template-columns: 8em 1fr;
    }
  }
  @media (max-width: 520px) {
    .loc__lines > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .loc__photo,
    .loc__map {
      aspect-ratio: 3 / 4;
    }
  }
</style>
