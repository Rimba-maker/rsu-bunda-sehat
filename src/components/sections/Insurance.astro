---
import { insurers, payments } from '../../data/insurance';

const tiles = insurers.slice(1, 8); // BPJS gets its own large tile
---
<section class="ins section wrap" aria-labelledby="ins-title">
  <div class="board">
    <div class="tile tile--head on-ink reveal">
      <h2 id="ins-title">Kami bekerja sama dengan</h2>
      <p>BPJS Kesehatan dan 20+ asuransi swasta, supaya Anda fokus sembuh, bukan mengurus berkas.</p>
    </div>
    <div class="tile tile--bpjs reveal" style="--i:1">
      <p class="tile__name">BPJS Kesehatan</p>
      <p class="tile__note">FKTL, dengan surat rujukan.</p>
    </div>
    {
      tiles.map((n, i) => (
        <div class:list={['tile', 'reveal', i % 2 ? 'tile--b' : 'tile--a']} style={`--i:${(i % 4) + 1}`}>
          <p class="tile__name">{n}</p>
        </div>
      ))
    }
    <div class="tile tile--more reveal" style="--i:2">
      <p class="tile__name">dan {insurers.length - 8}+ lainnya</p>
    </div>
  </div>

  <div class="pay">
    <h3 class="pay__title reveal">Cara pembayaran</h3>
    <ul>
      {
        payments.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <p class="pay__name">{p.name}</p>
            <p class="muted">{p.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .tile {
    display: grid;
    align-content: space-between;
    gap: 12px;
    min-height: clamp(150px, 15vw, 220px);
    padding: clamp(16px, 1.8vw, 26px);
    border-radius: var(--r);
    background: var(--bg-hi);
    transition: transform 0.5s var(--ease);
  }
  .tile:hover {
    transform: translateY(-4px);
  }
  .tile--b {
    background: var(--surface);
  }
  .tile--head {
    grid-column: span 2;
    background: var(--ink);
    color: var(--bg);
    align-content: space-between;
  }
  .tile--head h2 {
    font-size: var(--step-head);
    max-width: 14ch;
  }
  .tile--head p {
    max-width: 38ch;
    opacity: 0.92;
  }
  .tile--bpjs {
    grid-column: span 2;
    background: var(--surface);
  }
  .tile--bpjs .tile__name {
    font-size: var(--step-head);
    letter-spacing: -0.03em;
  }
  .tile--more {
    background: var(--ink);
    color: var(--bg);
  }
  .tile__name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tile__note {
    color: var(--muted);
  }
  .pay {
    margin-top: clamp(48px, 6vw, 88px);
    display: grid;
    gap: 28px;
  }
  .pay__title {
    font-size: var(--step-lead);
  }
  .pay ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pay li {
    position: relative;
    padding-left: 28px;
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .pay li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 14px;
    height: 20px;
    border-radius: 999px 999px 0 0;
    background: var(--ink);
  }
  .pay__name {
    font-size: var(--step-body);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .board {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .tile--head,
    .tile--bpjs {
      grid-column: 1 / -1;
    }
    .pay ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .pay ul {
      grid-template-columns: 1fr;
    }
  }
</style>
