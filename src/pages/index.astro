---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import QuickAccess from '../components/sections/QuickAccess.astro';
import Intro from '../components/sections/Intro.astro';
import Services from '../components/sections/Services.astro';
import Doctors from '../components/sections/Doctors.astro';
import Facilities from '../components/sections/Facilities.astro';
import MCU from '../components/sections/MCU.astro';
import Insurance from '../components/sections/Insurance.astro';
import HealthTips from '../components/sections/HealthTips.astro';
import PatientStories from '../components/sections/PatientStories.astro';
import Location from '../components/sections/Location.astro';
import BookingForm from '../components/sections/BookingForm.astro';
import CallBand from '../components/sections/CallBand.astro';
---
<BaseLayout>
  <TopBar />
  <Navbar />
  <main>
    <Hero />
    <QuickAccess />
    <Intro />
    <Services />
    <Doctors />
    <Facilities />
    <MCU />
    <Insurance />
    <HealthTips />
    <PatientStories />
    <Location />
    <BookingForm />
  </main>
  <CallBand />
  <Footer />

  <script>
    import '../scripts/reveal';
  </script>
</BaseLayout>
