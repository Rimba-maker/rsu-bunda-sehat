---
import { specialties } from '../../data/doctors';
import { site } from '../../data/site';
---
<section class="book section wrap" id="janji" aria-labelledby="book-title">
  <div class="coupon on-ink reveal">
    <div class="coupon__intro">
      <h2 id="book-title">Buat janji temu online</h2>
      <p>Pilih dokter, tanggal, dan jam yang sesuai. Kami konfirmasi dalam 1 jam kerja.</p>
      <p class="coupon__alt">
        Lebih suka langsung bicara? <a href={site.whatsappUrl} target="_blank" rel="noopener">Chat WhatsApp</a> atau
        <a href="tel:+62215551999">telepon customer care</a>.
      </p>
    </div>

    <form class="coupon__form" id="booking" novalidate>
      <label class="sr-only" for="b-name">Nama lengkap</label>
      <input class="field" id="b-name" name="nama" type="text" placeholder="Nama lengkap" autocomplete="name" required />

      <label class="sr-only" for="b-dob">Tanggal lahir atau NIK</label>
      <input class="field" id="b-dob" name="lahir" type="text" placeholder="Tanggal lahir atau NIK" autocomplete="bday" required />

      <label class="sr-only" for="b-wa">Nomor WhatsApp</label>
      <input class="field" id="b-wa" name="wa" type="tel" inputmode="tel" placeholder="Nomor WhatsApp" autocomplete="tel" required />

      <label class="sr-only" for="b-spec">Spesialisasi</label>
      <select class="field" id="b-spec" name="spec" required>
        <option value="">Pilih spesialisasi</option>
        {specialties.map((s) => <option value={s.label}>{s.label}</option>)}
        <option value="Medical Check-Up">Medical Check-Up</option>
      </select>

      <label class="sr-only" for="b-date">Tanggal pilihan</label>
      <input class="field" id="b-date" name="tanggal" type="date" aria-label="Tanggal pilihan" required />

      <label class="sr-only" for="b-doc">Dokter pilihan (opsional)</label>
      <input class="field" id="b-doc" name="dokter" type="text" placeholder="Dokter pilihan (opsional)" />

      <button class="btn coupon__submit" type="submit">Buat janji</button>
      <p class="coupon__status" id="b-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .coupon {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(28px, 4vw, 64px);
    border-radius: var(--r);
    background: var(--ink);
    color: var(--bg);
  }
  .coupon .btn {
    --btn-bg: var(--bg);
    --btn-fg: var(--ink);
  }
  .coupon__intro {
    display: grid;
    align-content: space-between;
    gap: 24px;
  }
  .coupon__intro h2 {
    font-size: var(--step-head);
    max-width: 11ch;
  }
  .coupon__intro p {
    max-width: 38ch;
  }
  .coupon__alt a {
    text-underline-offset: 0.25em;
    text-decoration-thickness: 2px;
  }
  .coupon__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .coupon__form .field {
    background: var(--bg-hi);
  }
  .coupon__form .field:first-of-type,
  .coupon__form input[name='dokter'],
  .coupon__submit,
  .coupon__status {
    grid-column: 1 / -1;
  }
  .coupon__submit {
    min-height: 58px;
    margin-top: 4px;
  }
  .coupon__status {
    min-height: 1.4em;
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .coupon {
      grid-template-columns: 1fr;
    }
    .coupon__form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /* No backend yet: the coupon opens WhatsApp with the message already written. */
  const form = document.getElementById('booking') as HTMLFormElement | null;
  const status = document.getElementById('b-status');
  if (form && status) {
    const set = (id: string, v?: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el && v) el.value = v;
    };

    window.addEventListener('booking:set', (e) => {
      const { doctor, spec, note } = (e as CustomEvent).detail as { doctor?: string; spec?: string; note?: string };
      set('b-spec', spec);
      set('b-doc', doctor ?? note);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = 'Mohon lengkapi data bertanda wajib terlebih dahulu.';
        form.reportValidity();
        return;
      }
      const d = new FormData(form);
      const msg = [
        'Halo RSU Bunda Sehat, saya ingin membuat janji temu.',
        `Nama: ${d.get('nama')}`,
        `Tgl lahir/NIK: ${d.get('lahir')}`,
        `WhatsApp: ${d.get('wa')}`,
        `Spesialisasi: ${d.get('spec')}`,
        d.get('dokter') ? `Dokter/paket: ${d.get('dokter')}` : '',
        `Tanggal pilihan: ${d.get('tanggal')}`,
      ]
        .filter(Boolean)
        .join('\n');
      window.open(`https://wa.me/6281234567890?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
      status.textContent = 'Terima kasih. WhatsApp akan terbuka dengan pesan yang sudah kami tuliskan, tinggal kirim.';
      form.reset();
    });
  }
</script>
