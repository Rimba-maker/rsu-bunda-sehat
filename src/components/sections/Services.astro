---
import { img } from '../../lib/assets';
import { services } from '../../data/services';
---
<section class="services section wrap" id="layanan" aria-labelledby="services-title">
  <header class="services__head">
    <div>
      <h2 id="services-title" class="reveal">Layanan medis kami</h2>
      <p class="services__sub reveal" style="--i:1">Pelayanan lengkap untuk segala usia, dari pencegahan sampai tindakan kompleks.</p>
    </div>
    <p class="services__count reveal" style="--i:2">{services.length} layanan</p>
  </header>

  <ul class="services__list">
    {
      services.map((s, i) => (
        <li class="svc reveal" style={`--i:${i % 2}`}>
          <span class="svc__photo arch">
            <img src={img(s.photo)} alt={s.alt} width="240" height="300" loading="lazy" />
          </span>
          <div class="svc__body">
            <h3 class="svc__name">
              <span>{s.name}</span>
              <span class="svc__meta">{s.meta}</span>
            </h3>
            <p class="svc__text">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .services__sub {
    margin-top: 16px;
    max-width: 44ch;
    color: var(--muted);
  }
  .services__count {
    font-size: var(--step-body);
    font-weight: 500;
    padding-bottom: 8px;
    white-space: nowrap;
  }
  .services__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 3.6vw, 52px) clamp(32px, 5vw, 72px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc {
    display: grid;
    grid-template-columns: clamp(76px, 7vw, 104px) 1fr;
    gap: 22px;
    align-items: start;
  }
  .svc__photo {
    aspect-ratio: 4 / 5;
    transition: transform 0.6s var(--ease);
  }
  .svc__photo img {
    transition: transform 1.2s var(--ease);
  }
  .svc:hover .svc__photo {
    transform: translateY(-6px);
  }
  .svc:hover .svc__photo img {
    transform: scale(1.1);
  }
  .svc__name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: var(--step-body);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .svc__meta {
    flex: none;
    font-size: var(--step-body);
    font-weight: 500;
    color: var(--muted);
    text-align: right;
  }
  .svc__text {
    margin-top: 10px;
    max-width: 40ch;
    font-size: var(--step-body);
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .services__list {
      grid-template-columns: 1fr;
    }
    .svc {
      grid-template-columns: 72px 1fr;
      gap: 18px;
    }
    .svc__name {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .svc__meta {
      text-align: left;
    }
  }
</style>
