---
import '../styles/global.css';
import { url } from '../lib/assets';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RSU Bunda Sehat — Rumah Sakit Umum Tipe B Jakarta Timur, 15 Spesialisasi',
  description = 'Rumah sakit umum tipe B di Jakarta Timur. 15 spesialisasi, IGD 24/7, 80+ dokter spesialis. Akreditasi Paripurna KARS. BPJS & 20+ asuransi.',
} = Astro.props;

const fontLatin = url('fonts/outfit-latin.woff2');
const fontLatinExt = url('fonts/outfit-latin-ext.woff2');
const og = new URL(url('img/hero-keluarga.jpg'), Astro.site ?? 'https://rimba-maker.github.io').href;

const fontCss = `
@font-face{font-family:'Outfit';font-style:normal;font-weight:100 900;font-display:swap;src:url(${fontLatinExt}) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Outfit';font-style:normal;font-weight:100 900;font-display:swap;src:url(${fontLatin}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['Hospital', 'MedicalOrganization'],
  name: site.name,
  description,
  telephone: '+62215551999',
  address: { '@type': 'PostalAddress', streetAddress: 'Jl. Bunda Sehat No. 88', addressLocality: 'Jakarta Timur', addressCountry: 'ID' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' },
  ],
  availableService: ['Rawat Jalan', 'Rawat Inap', 'IGD 24 Jam', 'Maternal & Anak', 'Cardiac Center', 'Laboratorium & Diagnostik', 'Vaksinasi', 'Medical Check-Up'].map((n) => ({
    '@type': 'MedicalProcedure',
    name: n,
  })),
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="rumah sakit jakarta timur, RSU akreditasi paripurna, dokter spesialis jakarta, IGD 24 jam, medical check up jakarta, RS BPJS jakarta timur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={og} />
    <meta name="theme-color" content="#351a2b" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#konten" class="sr-only">Lewati ke konten</a>
    <slot />
  </body>
</html>
