---
import { img } from '../../lib/assets';

const slot = (name: string, alt: string, pos = '50% 50%') => ({ src: img(name), alt, pos });
const poli = slot('rawat-jalan', 'Poliklinik', '50% 40%');
const igd = slot('igd-ambulans', 'IGD', '30% 40%');
const bersalin = slot('maternal', 'Ruang bersalin', '50% 30%');
const jantung = slot('jantung-ekg', 'Pemeriksaan jantung', '50% 50%');
---
<section class="intro section wrap" aria-labelledby="intro-title">
  <h2 id="intro-title" class="sr-only">Tentang RSU Bunda Sehat</h2>
  <p class="intro__statement lead reveal">
    Dari poliklinik <span class="slot arch"><img src={poli.src} alt="" width="120" height="140" loading="lazy" style={`object-position:${poli.pos}`} /></span> pagi hari sampai IGD
    <span class="slot arch"><img src={igd.src} alt="" width="120" height="140" loading="lazy" style={`object-position:${igd.pos}`} /></span> tengah malam, dari ruang bersalin
    <span class="slot arch"><img src={bersalin.src} alt="" width="120" height="140" loading="lazy" style={`object-position:${bersalin.pos}`} /></span> sampai pemeriksaan jantung
    <span class="slot arch"><img src={jantung.src} alt="" width="120" height="140" loading="lazy" style={`object-position:${jantung.pos}`} /></span>, kami merawat seluruh keluarga dengan hati dan menjelaskan dengan ilmu.
  </p>
  <div class="intro__side reveal" style="--i:1">
    <p>
      Nama kami artinya apa adanya: <strong>Bunda</strong> untuk kehangatan, <strong>Sehat</strong> untuk hasil yang kami janjikan.
      Dokter menjelaskan tanpa jargon dan tanpa menakut-nakuti.
    </p>
    <a href="#layanan" class="btn">Lihat semua layanan</a>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .intro__statement {
    max-width: 30em;
    line-height: 1.32;
  }
  .slot {
    display: inline-block;
    width: 0.95em;
    height: 1.22em;
    vertical-align: -0.16em;
    margin-inline: 0.06em;
    background: var(--surface);
  }
  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro__side {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 48ch;
  }
  @media (min-width: 900px) {
    .intro__side {
      margin-left: calc(50% + 24px);
    }
  }
</style>
