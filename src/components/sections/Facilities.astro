---
import { img } from '../../lib/assets';
import { facilities } from '../../data/facilities';
---
<section class="fac section wrap" id="fasilitas" aria-labelledby="fac-title">
  <header class="fac__head">
    <h2 id="fac-title" class="reveal">Fasilitas modern, pelayanan caring</h2>
    <p class="fac__sub reveal" style="--i:1">Dari kamar yang terasa seperti rumah sampai alat diagnostik terbaru, semuanya kami siapkan untuk membuat Anda tenang.</p>
  </header>

  <div class="fac__layout">
    <div class="fac__frame arch" aria-hidden="true">
      {
        facilities.map((f, i) => (
          <img
            src={img(f.photo)}
            alt=""
            width="900"
            height="1125"
            loading="lazy"
            class:list={[{ 'is-on': i === 0 }]}
            data-for={f.id}
            style={`object-position:${f.pos ?? '50% 50%'}`}
          />
        ))
      }
    </div>

    <ol class="fac__list">
      {
        facilities.map((f, i) => (
          <li class="fac__item" data-id={f.id} id={`fac-${f.id}`}>
            <div class="fac__mobile arch">
              <img src={img(f.photo)} alt={f.alt} width="600" height="750" loading="lazy" style={`object-position:${f.pos ?? '50% 50%'}`} />
            </div>
            <h3 class="reveal">{f.name}</h3>
            <ul class="reveal" style="--i:1">
              {f.lines.map((l) => <li>{l}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .fac__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .fac__sub {
    max-width: 46ch;
  }
  .fac__layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  /* The one frame whose contents change. */
  .fac__frame {
    position: sticky;
    top: 104px;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - 136px);
    width: 100%;
    justify-self: start;
    background: var(--surface);
  }
  .fac__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.9s ease-in-out,
      transform 1.6s var(--ease);
  }
  .fac__frame img.is-on {
    opacity: 1;
    transform: scale(1);
  }
  .fac__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(40px, 6vw, 88px);
    padding-block: 8px;
  }
  .fac__item {
    display: grid;
    gap: 14px;
    opacity: 0.45;
    transition: opacity 0.6s var(--ease);
  }
  .fac__item.is-active {
    opacity: 1;
  }
  .fac__item h3 {
    font-size: var(--step-lead);
    line-height: 1.1;
  }
  .fac__item ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 46ch;
  }
  .fac__item ul li {
    position: relative;
    padding-left: 24px;
  }
  .fac__item ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 10px;
    height: 14px;
    border-radius: 999px 999px 0 0;
    background: var(--ink);
  }
  .fac__mobile {
    display: none;
  }
  @media (max-width: 900px) {
    .fac__head {
      grid-template-columns: 1fr;
    }
    .fac__layout {
      grid-template-columns: 1fr;
    }
    .fac__frame {
      display: none;
    }
    .fac__item {
      opacity: 1;
    }
    .fac__mobile {
      display: block;
      width: min(100%, 320px);
      aspect-ratio: 4 / 5;
      margin-bottom: 8px;
    }
    .fac__mobile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>

<script>
  /* One frame, contents change: the photograph follows the facility being read. */
  const items = [...document.querySelectorAll<HTMLElement>('.fac__item')];
  const frames = [...document.querySelectorAll<HTMLImageElement>('.fac__frame img')];
  if (items.length && frames.length) {
    const setActive = (id: string) => {
      frames.forEach((f) => f.classList.toggle('is-on', f.dataset.for === id));
      items.forEach((i) => i.classList.toggle('is-active', i.dataset.id === id));
    };
    setActive(items[0].dataset.id!);
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.id!);
        });
      },
      { rootMargin: '-42% 0px -48% 0px', threshold: 0 },
    );
    items.forEach((i) => io.observe(i));
    items.forEach((i) => i.addEventListener('mouseenter', () => setActive(i.dataset.id!)));
  }
</script>
