---
import { img } from '../../lib/assets';
import { tips } from '../../data/content';
---
<section class="tips section" aria-labelledby="tips-title">
  <div class="wrap">
    <header class="tips__head">
      <h2 id="tips-title" class="reveal">Tips kesehatan</h2>
      <p class="reveal" style="--i:1">Ditulis oleh dokter kami, dengan bahasa yang bisa langsung Anda praktikkan di rumah.</p>
    </header>

    <ul class="tips__row">
      {
        tips.map((t, i) => (
          <li class:list={['tip', 'reveal', `tip--${i + 1}`]} style={`--i:${i}`}>
            <a href={t.href} class="tip__link">
              <span class="tip__photo arch">
                <img src={img(t.photo)} alt={t.alt} width="640" height="800" loading="lazy" />
              </span>
              <span class="tip__title">{t.title}</span>
              <span class="tip__by small">{t.by} · {t.read} baca</span>
              <span class="tip__more">Baca artikel</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tips {
    background: var(--surface);
  }
  .tips__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .tips__head p {
    max-width: 44ch;
  }
  .tips__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 48px);
    margin: 0;
    padding: 0 0 clamp(0px, 8vw, 128px);
    list-style: none;
    align-items: start;
  }
  /* A staircase, not a row of identical cards. */
  .tip--2 {
    margin-top: clamp(0px, 5vw, 80px);
  }
  .tip--3 {
    margin-top: clamp(0px, 10vw, 160px);
  }
  .tip__link {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  .tip__photo {
    aspect-ratio: 4 / 5;
    margin-bottom: 8px;
    background: var(--bg);
  }
  .tip__photo img {
    transition: transform 1.4s var(--ease);
  }
  .tip__link:hover .tip__photo img {
    transform: scale(1.07);
  }
  .tip__title {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.14;
    text-wrap: balance;
  }
  .tip__by {
    color: var(--muted);
    font-size: var(--step-small);
  }
  .tip__more {
    justify-self: start;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: transform 0.35s var(--ease);
  }
  .tip__link:hover .tip__more {
    transform: translateX(6px);
  }
  @media (max-width: 860px) {
    .tips__head {
      grid-template-columns: 1fr;
    }
    .tips__row {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .tip--2,
    .tip--3 {
      margin-top: 0;
    }
    .tip__photo {
      aspect-ratio: 5 / 4;
    }
  }
</style>
