---
import { img } from '../../lib/assets';
import { stories } from '../../data/content';
---
<section class="stories section wrap" aria-labelledby="stories-title" aria-roledescription="carousel">
  <h2 id="stories-title" class="reveal">Cerita dari pasien kami</h2>

  <div class="stories__stage" data-stories>
    {
      stories.map((s, i) => (
        <figure class:list={['story', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'} data-i={i}>
          <div class="story__photo arch">
            <img src={img(s.photo)} alt={s.alt} width="720" height="960" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position:${s.pos ?? '50% 40%'}`} />
          </div>
          <div class="story__text">
            <blockquote class="story__quote lead">
              <p>“{s.quote}”</p>
            </blockquote>
            <figcaption>
              <strong>{s.name}</strong>, {s.role}
            </figcaption>
          </div>
        </figure>
      ))
    }
  </div>

  <div class="stories__nav" role="tablist" aria-label="Pilih cerita">
    {
      stories.map((s, i) => (
        <button type="button" role="tab" class:list={['tab', { 'is-on': i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} data-to={i}>
          {s.name}
        </button>
      ))
    }
  </div>
  <p class="small muted stories__note">Cerita dibagikan atas persetujuan pasien; sebagian nama disamarkan.</p>
</section>

<style>
  .stories__stage {
    display: grid;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .story {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease-in-out,
      visibility 0s 1.2s;
  }
  .story.is-on {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .story__photo {
    grid-column: 2 / 6;
    aspect-ratio: 3 / 4;
    max-height: 72svh;
    width: 100%;
  }
  .story__photo img {
    transform: scale(1.04);
    transition: transform 8s linear;
  }
  .story.is-on .story__photo img {
    transform: scale(1.1);
  }
  .story__text {
    grid-column: 7 / 13;
    display: grid;
    align-content: start;
    gap: 28px;
    padding-top: clamp(24px, 8vw, 120px);
  }
  .story__quote {
    margin: 0;
    max-width: 30ch;
    font-weight: 400;
    font-size: var(--step-lead);
    line-height: 1.22;
  }
  .stories__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(28px, 3vw, 44px);
    margin-left: calc((100% - 11 * var(--gutter)) / 12 * 6 + 6 * var(--gutter));
  }
  .tab {
    min-height: 44px;
    padding: 0.4em 1.2em;
    border: 0;
    border-radius: var(--arch-btn);
    background: var(--surface);
    color: var(--ink);
    font: 500 var(--step-body)/1 var(--font);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.3s var(--ease);
  }
  .tab:hover {
    transform: translateY(-2px);
  }
  .tab.is-on {
    background: var(--ink);
    color: var(--bg);
  }
  .stories__note {
    margin-top: 20px;
    margin-left: calc((100% - 11 * var(--gutter)) / 12 * 6 + 6 * var(--gutter));
  }
  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
      row-gap: 28px;
    }
    .story__photo,
    .story__text {
      grid-column: 1;
    }
    .story__photo {
      width: 72%;
      max-height: 56svh;
    }
    .story__text {
      padding-top: 0;
    }
    .stories__nav,
    .stories__note {
      margin-left: 0;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stories]');
  if (stage) {
    const slides = [...stage.querySelectorAll<HTMLElement>('.story')];
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.stories__nav .tab')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    let paused = false;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-on', k === i);
        s.setAttribute('aria-hidden', String(k !== i));
      });
      tabs.forEach((t, k) => {
        t.classList.toggle('is-on', k === i);
        t.setAttribute('aria-selected', String(k === i));
      });
    };
    const start = () => {
      if (reduce || timer) return;
      timer = window.setInterval(() => !paused && show(i + 1), 8000);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
    stage.addEventListener('mouseenter', () => (paused = true));
    stage.addEventListener('mouseleave', () => (paused = false));
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
