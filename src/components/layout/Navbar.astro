---
import { site } from '../../data/site';
---
<header class="nav" id="top">
  <div class="wrap nav__in">
    <a href="#top" class="nav__brand" aria-label="RSU Bunda Sehat, ke atas">
      <svg viewBox="0 0 36 40" width="30" height="34" aria-hidden="true">
        <path d="M2 40V18a16 16 0 0 1 32 0v22z" fill="currentColor" />
        <path d="M11 40V20a7 7 0 0 1 14 0v20z" fill="var(--bg)" />
      </svg>
      <span>Bunda Sehat</span>
    </a>

    <nav class="nav__links" aria-label="Menu utama">
      {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__end">
      <a href="#janji" class="btn nav__cta">Buat janji temu</a>
      <details class="nav__menu">
        <summary aria-label="Buka menu">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 7h18M3 17h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" /></svg>
        </summary>
        <nav class="nav__drawer" aria-label="Menu seluler">
          {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#janji" class="btn">Buat janji temu</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
  }
  .nav__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step-lead);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--ink);
  }
  .nav__links {
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    font-size: var(--step-body);
  }
  .nav__links a {
    padding-block: 6px;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .nav__links a:hover {
    text-decoration-color: currentColor;
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav__cta {
    min-height: 46px;
    padding-inline: 1.4em;
    font-size: var(--step-body);
  }
  .nav__menu {
    display: none;
    position: relative;
  }
  .nav__menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--arch-btn);
    background: var(--surface);
    cursor: pointer;
  }
  .nav__menu summary::-webkit-details-marker {
    display: none;
  }
  .nav__drawer {
    position: absolute;
    right: 0;
    top: 56px;
    z-index: 5;
    display: grid;
    gap: 6px;
    min-width: 240px;
    padding: 18px;
    border-radius: 24px;
    background: var(--ink);
    color: var(--bg);
  }
  .nav__drawer a:not(.btn) {
    padding: 12px 8px;
    font-size: var(--step-body);
    text-decoration: none;
  }
  .nav__drawer .btn {
    --btn-bg: var(--bg);
    --btn-fg: var(--ink);
    margin-top: 6px;
  }
  @media (max-width: 960px) {
    .nav__links {
      display: none;
    }
    .nav__menu {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .nav__cta {
      display: none;
    }
  }
</style>
